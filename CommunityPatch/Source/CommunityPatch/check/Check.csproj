<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="salvage/**/*.cs" />
    <Reference Include="0Harmony;DistantWorlds.Core;DistantWorlds.Types;DistantWorlds.UI;DistantWorlds2;Stride.Core;Stride.Core.IO;Stride.Core.Serialization;Stride.Core.Mathematics;Stride.Graphics;Stride.Engine;Stride.Games;Stride.Input;Stride.Rendering" HintPath="$(GameRoot)/%(Identity).dll" Private="false" />
    <Content Include="$(GameRoot)/data/Hints.txt" Link="data/Hints.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
