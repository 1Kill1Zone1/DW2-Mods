<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Version>0.3.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameRoot Condition="'$(GameRoot)' == ''">C:/Games/Steam/steamapps/common/Distant Worlds 2</GameRoot>
    <ExpectedTypesSha256>787E4A1B6DA8763943A18DED8E3DC29BB452BA34297CEA2E726E5951B4F3B254</ExpectedTypesSha256>
  </PropertyGroup>
  <Target Name="VerifyGameBuild" BeforeTargets="CoreCompile">
    <GetFileHash Files="$(GameRoot)/DistantWorlds.Types.dll" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="TypesHash" />
    </GetFileHash>
    <Error Condition="'%(TypesHash.FileHash)' != '$(ExpectedTypesSha256)'"
           Text="Advanced Construction Mod supports Steam beta 1.3.8.7 only: DistantWorlds.Types.dll SHA-256 differs." />
  </Target>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Reference Include="0Harmony;DistantWorlds.Types;DistantWorlds.Core;DistantWorlds.UI;DistantWorlds2;Stride.Core;Stride.Core.Mathematics;Stride.Engine;Stride.Games;Stride.Graphics;Stride.Input;Stride.Rendering"
               HintPath="$(GameRoot)/%(Identity).dll" Private="false" />
  </ItemGroup>
</Project>
