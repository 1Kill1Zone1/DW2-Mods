index 0000000..0abbfa0
--- /dev/null
+++ b/dll/DW2CoherentResearch/MissionChannels.cs
@@ -0,0 +1,176 @@
+using DistantWorlds.Types;
+
+namespace DW2CoherentResearch;
+
+// Only the owning player's published designs cross the mod boundary.
+static class MissionChannels
+{
+    internal static void Install()
+    {
+        LiveChannel.Provide<Func<object, int, string>>("coherent-research.design-mission", 1, Mission);
+        LiveChannel.Provide<Func<object, int, string>>("coherent-research.design-mission-text", 1, Text);
+        LiveChannel.Provide<Action<object, int, int>>("coherent-research.design-copy-mission", 1, Copy);
+        LiveChannel.Provide<Func<object, int, Dictionary<string,string>>>("coherent-research.hull-missions", 1, Choices);
+        LiveChannel.Provide<Func<object, int, string, object>>("coherent-research.preview-mission", 1, Preview);
+        LiveChannel.Provide<Func<object, int, string, bool>>("coherent-research.save-mission", 1, Save);
+    }
+
+    static Dictionary<string,string> Choices(object campaign, int hullId)
+    {
+        try
+        {
+            if (campaign is not Galaxy galaxy || hullId < 0 || hullId > short.MaxValue) return null;
+            var empire = galaxy.Empires.GetPlayer();
+            var hull = empire?.Research?.ResearchedShipHulls?.GetById((short)hullId);
+            if (hull == null) return null;
+            var role = empire.InferShipRole(hull);
+            return ShipMissions.ChoicesFor(role)?.Where(m => m != ShipMissions.Carrier || role == ShipRole.Carrier || ShipMissions.HasHangars(hull))
+                .ToDictionary(m => m, ShipMissions.NameText);
+        }
+        catch (Exception) { return null; }
+    }
+
+    internal static object Preview(object campaign, int hullId, string mission)
+    {
+        if (mission == null || Choices(campaign, hullId)?.ContainsKey(mission) != true) return null;
+        var previousEmpire = ShipDesignBlock.ManualEmpire;
+        var previousMission = ShipMissions.Forced;
+        var previousLast = ShipMissions.Last;
+        var previousGenerating=ShipMissions.Generating;
+        var previousBand = RangeBands.Current;
+        try
+        {
+            var galaxy = (Galaxy)campaign;
+            var empire = galaxy.Empires.GetPlayer();
+            var research = empire.Research;
+            ShipDesignBlock.ManualEmpire = empire;
+            ShipMissions.Forced = mission;
+            var hull = research.ResearchedShipHulls.GetById((short)hullId);
+            return Design.GenerateNewDesign(galaxy, galaxy.StarDate, empire, research, hull, research.ResearchedComponents,
+                research.ComponentBestValues, research.WeaponBestValues, research.SizeBestValues, empire.Policy.ComponentSelectionFactors, 1f, null);
+        }
+        catch (Exception ex) { ModHost.Failed("previewing a player-selected mission", ex); return null; }
+        finally
+        {
+            ShipMissions.Forced = previousMission;
+            ShipMissions.Last = previousLast;
+            ShipMissions.Generating=previousGenerating;
+            RangeBands.Current = previousBand;
+            ShipDesignBlock.ManualEmpire = previousEmpire;
+        }
+    }
+
+    static bool Save(object campaign, int id, string mission)
+    {
+        try
+        {
+            var galaxy = campaign as Galaxy;
+            var target = Owned(galaxy, id);
+            return target != null && mission != null && Choices(galaxy, target.HullId)?.ContainsKey(mission) == true
+                && DesignLines.SaveSelectedMission(galaxy, target, mission);
+        }
+        catch (Exception) { return false; }
+    }
+
+    static Design Owned(Galaxy galaxy, int id)
+    {
+        if (galaxy == null || id < 0 || id == Constants.DesignDesignId) return null;
+        var player = galaxy.Empires.GetPlayer();
+        var design = galaxy.Designs.GetById(id);
+        return design != null && player != null && design.EmpireId == player.EmpireId
+            && ReferenceEquals(player.Designs.GetById(id), design) ? design : null;
+    }
+
+    // ACM supplies only active projects outside its series on hulls for which it suppressed native automation.
+    internal static void ReviewUnclassified(object campaign,int[] ids)
+    {
+        if(campaign is not Galaxy galaxy || ids == null)return;
+        try
+        {
+            var empire=galaxy.Empires.GetPlayer();
+            if(empire==null || empire.Policy.GetAutomationLevel(AutomationCategory.ShipDesigns)!=AutomationLevel.Automated)return;
+            var sources=ids.Distinct().Select(id=>Owned(galaxy,id)).Where(d=>d!=null&&!d.Obsolete)
+                .Select(d=>(Design:d,Mission:DesignLines.KnownMission(galaxy,d))).Where(pair=>pair.Mission!=null)
+                .GroupBy(pair=>(pair.Design.HullId,pair.Mission))
+                .Select(group=>group.OrderByDescending(pair=>pair.Design.StarDate).ThenByDescending(pair=>pair.Design.DesignId).First()).ToArray();
+            foreach(var (source,mission) in sources)UpgradeUnclassified(galaxy,empire,source,mission);
+        }
+        catch(Exception ex){ModHost.Failed("reviewing unclassified mission designs",ex);}
+    }
+
+    static void UpgradeUnclassified(Galaxy galaxy,Empire empire,Design source,string mission)
+    {
+        if(Preview(galaxy,source.HullId,mission) is not Design next)return;
+        static IEnumerable<(int,int)> Equipment(Design d)=>d.Components.Where(c=>!c.IsEmpty)
+            .Select(c=>((int)c.ComponentId,(int)c.Level)).OrderBy(c=>c.Item1).ThenBy(c=>c.Item2);
+        if(Equipment(source).SequenceEqual(Equipment(next)))return;
+        next.Name=TextHelper.GenerateUpgradedDesignName(source.Name);
+        next.StarDate=galaxy.StarDate;
+        next.AllowAutoRetrofit=source.AllowAutoRetrofit;
+        next.UpgradeDesignId=source.UpgradeDesignId;
+        if(source.Tactics!=null)next.Tactics=source.Tactics.Clone();
+        if(!Design.CheckDesignIsValid(galaxy,empire,next))return;
+        next.DesignId=galaxy.Designs.GetNextId();
+        int oldTarget=source.UpgradeDesignId;
+        bool committed=false;
+        try
+        {
+            galaxy.Designs.Add(next);
+            empire.Designs.Add(next);
+            if(!DesignLines.SaveSelectedMission(galaxy,next,mission))return;
+            source.Obsolete=true;
+            if(oldTarget!=int.MinValue)source.UpgradeDesignId=next.DesignId;
+            empire.ReviewLatestDesignsPerRole();
+            empire.ReviewLatestDesignsPerShipHull();
+            committed=true;
+        }
+        finally
+        {
+            if(!committed)
+            {
+                source.Obsolete=false;
+                source.UpgradeDesignId=oldTarget;
+                if(ReferenceEquals(empire.Designs.GetById(next.DesignId),next))empire.Designs.CheckRemove(next);
+                if(ReferenceEquals(galaxy.Designs.GetById(next.DesignId),next))galaxy.Designs.CheckRemove(next);
+                DesignLines.Forget(galaxy,next.DesignId);
+                empire.ReviewLatestDesignsPerRole();empire.ReviewLatestDesignsPerShipHull();
+            }
+        }
+    }
+
+    static string Mission(object campaign, int id)
+    {
+        try
+        {
+            var galaxy = campaign as Galaxy;
+            var design = Owned(galaxy, id);
+            return design == null ? null : DesignLines.KnownMission(galaxy, design);
+        }
+        catch (Exception) { return null; }
+    }
+
+    static string Text(object campaign, int id)
+    {
+        try
+        {
+            var mission = Mission(campaign, id);
+            return mission == null ? null : ShipMissions.NameText(mission);
+        }
+        catch (Exception) { return null; }
+    }
+
+    static void Copy(object campaign, int sourceId, int targetId)
+    {
+        try
+        {
+            if (campaign is not Galaxy galaxy || sourceId == targetId) return;
+            var target = Owned(galaxy, targetId);
+            if (target == null) return;
+            var sourceMission = Mission(galaxy, sourceId);
+            var choices = ShipMissions.ChoicesFor(target.GetRole(galaxy));
+            if (sourceMission == null || choices == null || Array.IndexOf(choices, sourceMission) < 0) return;
+            DesignLines.KeepInheritedMission(galaxy, target, sourceMission);
+        }
+        catch (Exception ex) { ModHost.Failed("copying the mission of an upgraded design", ex); }
+    }
+}
