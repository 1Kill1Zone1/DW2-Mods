+using System.Collections.Concurrent;
+using System.Runtime.CompilerServices;
+using System.Text.Json;
+using DistantWorlds.Types;
+
+namespace DW2CoherentResearch;
+
+static class MissionPresets
+{
+    internal static bool Enabled;
+    internal sealed record Values(float Reach, TacticsStance? Stance, float PointDefenseShare, bool PointDefenseAnyBay,
+        float HoldBack, float CarrierHangars, bool FleetParts, string WeaponFamily)
+    {
+        internal static Values From(ShipMissions.Mission m) => new(m.Reach,m.Stance,m.PointDefenseShare,m.PointDefenseAnyBay,
+            m.HoldBack,m.CarrierHangars,m.FleetParts,m.WeaponFamily);
+        internal bool Valid => new[]{Reach,PointDefenseShare,HoldBack,CarrierHangars}.All(n=>n>=0 && n<=1)
+            && (Stance is null or TacticsStance.Aggressive or TacticsStance.Neutral or TacticsStance.Cautious)
+            && (WeaponFamily?.Length??0)<=128;
+        internal ShipMissions.Mission Apply(ShipMissions.Mission m) => new() {Name=m.Name, Code=m.Code,
+            Reach=Reach,Stance=Stance,PointDefenseShare=PointDefenseShare,PointDefenseAnyBay=PointDefenseAnyBay,
+            HoldBack=HoldBack,CarrierHangars=CarrierHangars,FleetParts=FleetParts,WeaponFamily=WeaponFamily,EditedPreset=true};
+    }
+
+    internal enum Scope { Global, Class, Hull }
+    // Cache individual records (including absence), never a resolved child: parent changes apply immediately.
+    sealed record Entry(Values Value);
+    static readonly ConditionalWeakTable<Empire,ConcurrentDictionary<string,Entry>> cache=new();
+    static string Key(Empire empire,ShipRole role,ShipHull hull,string name,Scope scope)
+    {
+        string target=scope switch {Scope.Global=>"all",Scope.Hull=>$"hull.{hull.ShipHullId}",_=>role.ToString()};
+        return $"preset.v1.{empire.EmpireId}.{target}.{name}";
+    }
+    internal sealed record Override(Empire Empire,ShipRole Role,string Name,Values Values);
+    [ThreadStatic] internal static Override Preview;
+
+    internal static Values Stored(Empire empire,ShipRole role,ShipHull hull,string name,Scope scope)
+    {
+        if(scope==Scope.Hull && hull==null)return null;
+        var key=Key(empire,role,hull,name,scope);
+        var entries=cache.GetOrCreateValue(empire);
+        if(entries.TryGetValue(key,out var cached))return cached.Value;
+        var get=ProfileChoices.Getter;
+        if(get==null)return null;
+        var raw=get(empire.Galaxy,"coherent-research",key);
+        Values value=null;
+        if(!string.IsNullOrEmpty(raw))
+        {
+            try {var parsed=JsonSerializer.Deserialize<Values>(raw);if(parsed?.Valid==true)value=parsed;}
+            catch(JsonException ex){ModHost.Failed("reading mission preset",ex);}
+        }
+        return entries.GetOrAdd(key,new Entry(value)).Value;
+    }
+    internal static Values Effective(Empire empire,ShipRole role,ShipHull hull,string name,Scope scope)
+    {
+        Values Read(Scope level)=>Stored(empire,role,hull,name,level);
+        if(scope==Scope.Hull && Read(Scope.Hull) is {} exact)return exact;
+        if(scope!=Scope.Global && Read(Scope.Class) is {} group)return group;
+        return Read(Scope.Global);
+    }
+    internal static ShipMissions.Mission Resolve(Empire empire,ShipRole role,ShipMissions.Mission basis,ShipHull hull)
+    {
+        if(!Enabled || empire?.IsPlayer!=true)return basis;
+        if(Preview is {} edit && ReferenceEquals(edit.Empire,empire) && role==edit.Role && basis.Name==edit.Name)
+            return edit.Values.Apply(basis);
+        return Effective(empire,role,hull,basis.Name,Scope.Hull)?.Apply(basis)??basis;
+    }
+    internal static bool Save(Empire empire,ShipRole role,ShipHull hull,string name,Scope scope,Values value)
+    {
+        var set=ProfileChoices.Setter;
+        var get=ProfileChoices.Getter;
+        if(!Enabled || empire?.IsPlayer!=true || value?.Valid==false || set==null || get==null)return false;
+        var key=Key(empire,role,hull,name,scope);
+        var raw=value==null?string.Empty:JsonSerializer.Serialize(value);
+        set(empire.Galaxy,"coherent-research",key,raw);
+        if((get(empire.Galaxy,"coherent-research",key)??string.Empty)!=raw)return false;
+        cache.GetOrCreateValue(empire)[key]=new Entry(value);
+        return true;
+    }
+}
